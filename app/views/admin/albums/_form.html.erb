<!-- app/views/admin/albums/_form.html.erb -->
<%= form_with model: [:admin, @album], html: { multipart: true }, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :title, "Titre", class: "block text-sm font-medium" %>
    <%= f.text_field :title, class: "mt-1 w-full rounded border p-2" %>
  </div>

  <div>
    <%= f.label :cover, "Cover (image)", class: "block text-sm font-medium" %>
    <%= f.file_field :cover, direct_upload: true, accept: "image/*", class: "mt-1 w-full rounded border p-2 bg-white" %>
    <% if @album.cover.attached? %>
      <div class="mt-2"><%= image_tag @album.cover.variant(resize_to_limit: [320, 320]), class: "rounded-lg" %></div>
    <% end %>
  </div>

  <div>
    <%= f.label :release_year, "Année de sortie", class: "block text-sm font-medium" %>
    <%= f.number_field :release_year, class: "mt-1 w-full rounded border p-2" %>
  </div>

  <div class="flex justify-end gap-2">
    <%= link_to "Annuler", admin_dashboard_path, class: "px-3 py-2 rounded border" %>
    <%= f.submit "Enregistrer", class: "px-3 py-2 rounded bg-blue-600 text-white" %>
  </div>
<% end %>
